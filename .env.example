# Copy this file to .env and fill in values. Never commit .env.

# Stage 1: Robotics Stack Exchange collector (raises limit 300 -> 10,000 req/day)
STACKEXCHANGE_KEY=

# Stage 1: GitHub collector. Optional: if empty, the token from `gh auth token` is used.
GITHUB_TOKEN=

# Stage 6: open-source LLM via hosted OpenAI-compatible API (pick one)
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Stage 7: only if the open model misses targets
ANTHROPIC_API_KEY=
